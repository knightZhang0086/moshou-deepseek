{
  "name": "@moshou/server",
  "private": true,
  "version": "0.5.0",
  "description": "《墨守成规》邀请码在线对战 WebSocket 房间服务器（权威校验）",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
